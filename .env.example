# ============================================================================
# ＧＡＭＥＲ-ＣＯＲＰ - Multi-Account Web Dashboard Environment Variables (.env.example)
# Copy this file to `.env` and customize values before production deployment.
# ============================================================================

# --- Administrator Authentication ---
ADMIN_USERNAME=admin
# Set a UNIQUE secret of at least 12 characters in your private .env / hosting secrets.
# If omitted on a writable local server, a random password is generated in .env.
# Changing this active secret and restarting syncs the saved hash; unchanged secret
# preserves a password changed via Admin Settings. Hosting env overrides .env.
ADMIN_PASSWORD=
# Optional explicit one-boot operator reset if Settings password must be reset
# without rotating the configured secret. Back up DB/.env; remove flag afterward.
ADMIN_PASSWORD_RESET_ON_START=0
SESSION_EXPIRE_HOURS=24

# --- Cryptographic Keys (Auto-generated if left blank) ---
# SECRET_KEY: 64-char hex string for HMAC-SHA256 session signing
SECRET_KEY=
# FERNET_KEY: URL-safe key for encrypting account passwords and Access Tokens at rest
FERNET_KEY=

# --- Server & Persistence Paths ---
HOST=0.0.0.0
PORT=7723
DATABASE_PATH=data/dashboard.db
DEVICES_FILE_PATH=data/devices.json
DEFAULT_ACCOUNT_REGION=ME
# Start with conservative defaults. 1000 registered IDs != 1000 simultaneous sessions.
MAX_ACTIVE_WORKERS=50
MAX_CONCURRENT_LOGINS=8
# Reconnect if a joined UDP session stops receiving valid packets (seconds).
UDP_IDLE_RECONNECT_SECONDS=180
# Time after startup packets with no server JOIN_MATCH; reconnect/requeue (seconds).
UDP_JOIN_TIMEOUT_SECONDS=75

# --- Protocol & Encryption Settings (Used by lv.py) ---
FF_AES_KEY=Yg&tc%DEuh6%Zc^8
FF_AES_IV=6oyZDr22E3ychjM%
GARENA_CLIENT_ID=100067
GARENA_CLIENT_SECRET=2ee44819e9b4598845141067b281621874d0d5d7af9d8f7e00c1e54715b7d1e3
# Access Token login uses HTTPS POST JSON {"access_token":"..."}; never put a token in this file.
ACCESS_JWT_API_URL=https://sabbir-paid-api2.vercel.app/access-jwt

# Per-account circuit breaker: 100 sent requests without JOIN -> 10 minutes fully offline
QUEUE_NO_JOIN_LIMIT=100
QUEUE_COOLDOWN_SECONDS=600

# De-synchronized TCP queue cadence per worker (1–30 seconds; default 3)
START_MATCH_INTERVAL_SECONDS=3

# ---------------------------------------------------------------------------
# Daily EXP target (auto-offline)
# Levels 1-29 stop at 5,000 EXP/day, levels 30+ at 50,000 EXP/day by default.
# Only server-verified profile EXP increases are counted; when the target for
# the account's level is reached the worker is taken offline automatically and
# starts again after the next daily reset (00:00 in the offset below).
# ---------------------------------------------------------------------------
DAILY_EXP_ENABLED=true
DAILY_EXP_LOW_LEVEL_MAX=29
DAILY_EXP_LOW_LIMIT=5000
DAILY_EXP_HIGH_LIMIT=50000
# Local midnight boundary for "today" (6 = UTC+6, Asia/Dhaka).
DAILY_EXP_RESET_OFFSET_HOURS=6
# Optional: start accounts again automatically once the day resets.
DAILY_EXP_AUTO_RESUME=false
DAILY_EXP_HISTORY_DAYS=14

# ---------------------------------------------------------------------------
# EXP credit diagnosis ("bot runs for hours but the account gains no EXP")
# The dashboard can only report what the game server returns. These two knobs
# control how fast it can prove that, and when it warns you.
# ---------------------------------------------------------------------------
# How often the real server profile is re-read (seconds, 15-600).
PROFILE_POLL_SECONDS=45
# Warn once the profile EXP has not moved for this many minutes while running.
EXP_STALL_MINUTES=30
# Do not repeat that warning more often than this (minutes).
EXP_STALL_RELOG_MINUTES=60
# Keep the UDP session longer so a match can settle before the idle rejoin
# (seconds, default 180). EXP is credited by the game server at settlement.
UDP_IDLE_RECONNECT_SECONDS=180

# ---------------------------------------------------------------------------
# Safety rails (hosting server + game servers)
# These are the limits that keep this instance light and keep the game API from
# ever seeing a burst. Defaults are conservative — raise only if you know why.
# ---------------------------------------------------------------------------
# Most profile reads running at the same time across all accounts.
PROFILE_CHECK_CONCURRENCY=3
# Slowest a profile read is ever retried after repeated failures (seconds).
PROFILE_POLL_MAX_SECONDS=300
# Minimum gap between an early (match-triggered) check and the previous one.
PROFILE_FORCED_MIN_INTERVAL_SECONDS=10
# Consecutive failed reads before an account starts waiting longer each time.
GAME_API_BACKOFF_THRESHOLD=5
# Workers and logins allowed at the same time on this instance.
MAX_ACTIVE_WORKERS=50
MAX_CONCURRENT_LOGINS=8

# Build identity shown in the console header, in /health and in the startup log.
# Bump it (or set it in the hosting dashboard) so you can always tell which build runs.
APP_BUILD=v18-2026-10-12
